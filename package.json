{
  "name": "kuberq-b2b-os",
  "version": "2.1.0",
  "description": "KuberQ — High-Concurrency B2B & Retail Operating System (GST Billing, 3-Digit POS Tokens & Clustered Backend)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:cluster": "npx pm2-runtime start ecosystem.config.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:monit": "pm2 monit"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "pm2": "^5.3.1"
  }
}
